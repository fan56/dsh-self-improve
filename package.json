{
  "name": "@aiwayds/dsh-self-improve",
  "version": "0.1.0",
  "description": "dsh-plugin: the self-improvement loop for dsh — session signals become lessons (auto-applied, low-risk) and skill drafts (human-approved before install); topics-memory's ledger is the input",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "plugin",
    "self-improvement",
    "lessons",
    "skills",
    "reflection"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fan56/dsh-self-improve.git"
  },
  "homepage": "https://github.com/fan56/dsh-self-improve",
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test 'test/*.test.mjs'",
    "smoke": "node scripts/smoke-boot.mjs"
  },
  "peerDependencies": {
    "@aiwayds/dsh-topics-memory": ">=0.24.0",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-commands": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": ">=0.2.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@aiwayds/dsh-topics-memory": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-util-values": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aiwayds/dsh-topics-memory": "0.25.0",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.2"
  }
}
